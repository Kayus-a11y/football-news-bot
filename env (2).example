# Copy this file to `.env` and fill in your real credentials.
# NEVER commit your actual .env file to version control.

# From @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# The channel your bot posts to. Must be a public channel username
# (e.g. @FootballDailyHubs) or a numeric chat ID, and the bot must
# already be added as an admin of that channel.
CHANNEL_ID=@FootballDailyHubs

# Free at https://newsapi.org
NEWS_API_KEY=your_newsapi_key_here

# Free at https://api-sports.io (API-Football)
API_FOOTBALL_KEY=your_apifootball_key_here

# Optional: override default fonts (paths must exist on the host)
# FONT_BOLD_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
# FONT_REGULAR_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
